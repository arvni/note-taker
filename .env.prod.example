# Production environment for docker-compose.prod.yml. Copy to .env.prod and fill
# in. NEVER commit .env.prod. Generate keys with: openssl rand -base64 32

APP_ENV=production
HTTP_ADDR=:8080
PUBLIC_BASE_URL=https://calendar-sync.example.com

# ── Postgres (compose service) ──
POSTGRES_USER=fathom
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=fathom
DATABASE_URL=postgres://fathom:CHANGE_ME_STRONG@postgres:5432/fathom?sslmode=disable

# ── Redis (compose service) ──
REDIS_URL=redis://redis:6379/0

# ── Encryption & sessions (from a secret store ideally) ──
CRYPTO_MASTER_KEY=            # openssl rand -base64 32
SESSION_KEY=                  # openssl rand -base64 32 (different from crypto key)
SESSION_TTL=30m

# ── Zoho OAuth (register redirect below in the API Console) ──
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=https://calendar-sync.example.com/oauth/zoho/callback
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.com
ZOHO_CALENDAR_BASE=https://calendar.zoho.com/api/v1
ZOHO_SCOPES=ZohoCalendar.calendar.READ,ZohoCalendar.event.READ,aaaserver.profile.READ

# ── Admin SSO (OIDC) ──
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=https://calendar-sync.example.com/auth/callback
OIDC_HOSTED_DOMAIN=example.com          # optional: restrict to your Workspace domain
ADMIN_EMAILS=you@example.com            # comma-separated allowlist -> org_admin
ADMIN_ORG_ID=1

# ── Email (transactional SMTP; e.g. Zoho Mail or a provider) ──
EMAIL_FROM=calendar-integration@example.com
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Google Calendar destination ──
GOOGLE_CALENDAR_BASE=https://www.googleapis.com/calendar/v3
GOOGLE_CALENDAR_ID=                     # the Fathom-watched calendar id
GOOGLE_CREDENTIALS_FILE=/app/secrets/google-sa.json   # mount the service-account key

# ─── Google OAuth (admin "Connect Google Calendar" for the destination) ───
# A Google OAuth 2.0 Web client; register redirect <PUBLIC_BASE_URL>/oauth/google/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=
GOOGLE_SUBJECT=                         # optional: domain-wide delegation user

# ── Fathom ──
FATHOM_API_BASE=https://api.fathom.ai/external/v1
FATHOM_API_KEY=

# ── Branding / support ──
COMPANY_NAME=Your Company
APP_NAME=Calendar Bridge
SUPPORT_ADDR=support@example.com
PRIVACY_URL=https://example.com/privacy
TERMS_URL=https://example.com/terms

# ── Rate limits / retention (review with legal) ──
RATE_LIMIT_OAUTH=10
RATE_LIMIT_CONNECT=20
RATE_LIMIT_API=60
RATE_LIMIT_WINDOW=10m
RETENTION_PURGE_INTERVAL=24h
RETENTION_AUDIT=8760h
RETENTION_MAPPINGS=8760h
DIRECTORY_SYNC_INTERVAL=1h

ZOHO_DIRECTORY_USERS_URL=https://www.zohoapis.com/directory/api/v2/orgs/936948838/users?page=1&per_page=500&include=emails
# Directory refresh token from authorizing the CALENDAR app (server-based) with
# ZohoDirectory.Users.READ — a separate Self Client is NOT required. Leave the
# CLIENT_ID/SECRET below blank to refresh with the main app.
ZOHO_DIRECTORY_CLIENT_ID=
ZOHO_DIRECTORY_CLIENT_SECRET=
ZOHO_DIRECTORY_REFRESH_TOKEN=
