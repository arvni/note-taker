# ─── Server ───────────────────────────────────────────────
APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_BASE_URL=https://calendar-sync.company.com

# ─── PostgreSQL ───────────────────────────────────────────
DATABASE_URL=postgres://fathom:fathom@localhost:5432/fathom?sslmode=disable

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Encryption (spec §14) ────────────────────────────────
# Key MUST NOT live in Postgres. In prod use KMS/Vault.
# For local/dev: base64-encoded 32-byte key (AES-256-GCM, spec §13).
# Generate: openssl rand -base64 32
CRYPTO_MASTER_KEY=

# ─── Zoho OAuth (spec §8-12) — register in Zoho API Console ──
# client_secret is confidential; NEVER expose to the browser (spec §12)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Must be pre-registered in the Zoho API Console (spec §10)
ZOHO_REDIRECT_URI=https://calendar-sync.company.com/oauth/zoho/callback
# Data-center specific accounts domain, e.g. https://accounts.zoho.com (or .eu/.in/.com.au)
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.com
# Calendar API base, e.g. https://calendar.zoho.com/api/v1
ZOHO_CALENDAR_BASE=https://calendar.zoho.com/api/v1
# Minimum scopes only (spec §11, §53). No Mail scopes (spec §33). No .ALL (spec §11).
# aaaserver.profile.READ is required by /oauth/user/info for identity binding (spec §25-26).
ZOHO_SCOPES=ZohoCalendar.calendar.READ,ZohoCalendar.event.READ,aaaserver.profile.READ

# ─── Onboarding (spec §6-7) ───────────────────────────────
ONBOARDING_TOKEN_TTL=168h    # 7 days, configurable
ONBOARDING_TOKEN_BYTES=48    # 32 min, 48 preferred

# ─── Email (spec §21) ─────────────────────────────────────
EMAIL_FROM=calendar-integration@company.com
EMAIL_PROVIDER=              # approved transactional provider / Zoho Mail send API

# ─── Google Calendar destination (spec §42) ───────────────
# Destination calendar id that Fathom watches, and the Google API base.
GOOGLE_CALENDAR_BASE=https://www.googleapis.com/calendar/v3
GOOGLE_CALENDAR_ID=
# Service-account access token source (placeholder until service-account/JWT
# exchange is wired). Leave blank to disable outbound sync.
GOOGLE_ACCESS_TOKEN=
GOOGLE_CREDENTIALS_JSON=

# ─── Fathom (spec §43) — documented API only ──────────────
FATHOM_API_BASE=
FATHOM_API_KEY=

# ─── Directory sync (spec §3, §20, §55) ───────────────────
# Zoho Directory REST users endpoint (org/DC-specific); leave blank to rely on
# the CSV import fallback. Fields mapped: zuid, emails[].email_id, is_active,
# display_name. No Mail scopes (spec §33).
ZOHO_DIRECTORY_USERS_URL=
DIRECTORY_SYNC_INTERVAL=1h

# ─── Branding / consent copy (spec §22-23) ────────────────
COMPANY_NAME=Your Company
APP_NAME=Calendar Bridge
SUPPORT_ADDR=support@company.com
PRIVACY_URL=
TERMS_URL=

# ─── Admin sessions & SSO (spec §38-39) ───────────────────
# HMAC key for signing session cookies (>=32 bytes). openssl rand -base64 32
SESSION_KEY=
SESSION_TTL=30m
# Admin SSO is via OIDC (Zoho Directory / Entra / Google Workspace); the
# IdentityProvider is wired per company. Employees authenticate via Zoho OAuth.
